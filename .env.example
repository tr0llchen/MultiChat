# Copy this file to .env to change the defaults. All settings are optional.

# Port on the host.
PORT=3000

# Secret that encrypts the provider API keys in the database.
# If empty, a random secret is generated and kept in the data volume.
# Generate one with: openssl rand -base64 32
APP_SECRET=

# Set to true when you serve the app over HTTPS.
COOKIE_SECURE=false
